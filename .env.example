# ---------------------------------------------------------------------------
# FeastCraft environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# SQLite database file. The path is resolved relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-insecure-secret-change-me"

# Stripe test-mode keys. Leave STRIPE_SECRET_KEY empty to run the site in
# "demo payment" mode, where orders are confirmed without contacting Stripe.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional: set to the Stripe endpoint secret after running
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Required for card orders to be marked paid if the browser confirmation is
# interrupted. Leave empty to rely on the client confirmation step only.
STRIPE_WEBHOOK_SECRET=""

# Absolute origin used for metadata and any Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
